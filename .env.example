# MongoDB (local)
MONGODB_URI=mongodb://127.0.0.1:27017/fidence
MONGODB_DB=fidence

# Base URL used when generating payment links (defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional production pay domain override (e.g. https://pay.fidence.xyz)
# NEXT_PUBLIC_PAYMENT_DOMAIN=https://pay.fidence.xyz

# Required for WalletConnect / RainbowKit (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

# Upstash Redis (session cache, rate limits, activity queue)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Internal cron job auth (Vercel Cron)
CRON_SECRET=

# Resend (invoice share + payment notifications)
# https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender, e.g. Fidence <invoices@yourdomain.com>
RESEND_FROM_EMAIL=

# Optional: enable Sepolia testnet in production builds (on by default in development)
# NEXT_PUBLIC_ENABLE_TESTNETS=true

# PAYAGENT token + oracle (Sepolia)
# NEXT_PUBLIC_PAYAGENT_TOKEN_ADDRESS=0x...
# NEXT_PUBLIC_PAYAGENT_ORACLE_ADDRESS=0x...

# Contract deploy (solidity/ Hardhat scripts)
# PRIVATE_KEY=
# RPC_URL=
# ETHERSCAN_API_KEY=

# Optional tuning
# SESSION_CACHE_ENABLED=true
# ACTIVITY_HOT_DAYS=90

# --- Settlement verification ---
# Production: unset or wagmi (full on-chain verify). Dev only: format | off | contract
# PAYMENT_SETTLEMENT_VERIFY_MODE=wagmi

# --- EVM RPC (Alchemy or explicit URLs) ---
# Server-side Alchemy key (preferred for settlement verifiers)
# ALCHEMY_API_KEY=
# Optional public Alchemy key for client-side reads
# NEXT_PUBLIC_ALCHEMY_API_KEY=
# Per-chain RPC overrides (used when set; otherwise Alchemy host is derived from ALCHEMY_API_KEY)
# NEXT_PUBLIC_ETHEREUM_RPC_URL=
# NEXT_PUBLIC_BASE_RPC_URL=
# NEXT_PUBLIC_SEPOLIA_RPC_URL=
# NEXT_PUBLIC_SOLANA_RPC_URL=

# --- CoinGecko (ETH/SOL USD valuation for compliance caps) ---
# COINGECKO_API_KEY=
# demo (default) or pro
# COINGECKO_API_TIER=demo

# --- Compliance enforcement ---
# Default: enforce. Set off only with break-glass in non-production emergencies.
# COMPLIANCE_ENFORCEMENT=on
# COMPLIANCE_ENFORCEMENT_BREAK_GLASS=0

# --- Agent integrations ---
# Optional external content moderation for agent requests
# SUPERAGENT_API_KEY=
# Require cryptographically verified agent wallets (enable after Phase 5 e2e)
# AGENT_REQUIRE_VERIFIED_WALLET=false

# --- Agent E2E / CLI scripts ---
# PAYAGENT_API_KEY=fid_live_...
# PAYAGENT_BASE_URL=http://localhost:3000
# SEPOLIA_PRIVATE_KEY=
# AGENT_E2E_MAINNET=0

# --- Pay agent connect ---
# PAY_AGENT_CONNECT_ENABLED=true
# AGENT_LINK_TTL_MINUTES=15
# PAYMENT_INTENT_TTL_MINUTES=30
# MAX_LINKED_AGENTS_PER_WORKSPACE=5
# AGENT_E2E_SESSION_TOKEN=
# AGENT_E2E_SCOPED_KEY=fid_agent_...
